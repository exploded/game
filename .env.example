BASE_URL=http://localhost:8888
# Email through Amazon SES. Leave the keys empty in dev: emails, including
# sign-in links, print to the console instead.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-southeast-2
MAIL_FROM=StockGame <stockgame@mchugh.au>
# Optional. Reply-to address for news from Rob.
NEWS_REPLY_TO=
ADMIN_EMAIL=
PORT=8888
PROD=0
# Optional. Address to listen on. Defaults to 127.0.0.1 when PROD=1 (only
# Caddy needs to reach it) and to every interface otherwise (LAN phone testing).
BIND_ADDR=
# Optional. IANA zone for game start and end dates. Defaults to UTC.
TIMEZONE=
TWELVEDATA_API_KEY=
# Optional. Comma-separated symbols the Twelve Data jobs are limited to. Set it
# on a dev machine so dev doesn't eat into production's 610 credits a minute.
TWELVEDATA_SYMBOLS=
MONITOR_URL=
MONITOR_API_KEY=
