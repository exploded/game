BASE_URL=http://localhost:8888
# Email through Amazon SES. Leave the keys empty in dev: emails, including
# sign-in links, print to the console instead.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-southeast-2
MAIL_FROM=StockGame <stockgame@mchugh.au>
# Optional. Reply-to address for news from Rob.
NEWS_REPLY_TO=
# Who sends newsletters, with a postal address, for the email footer. The
# newsletter page won't send without it.
NEWS_SENDER=
ADMIN_EMAIL=
PORT=8888
PROD=0
# Optional. Address to listen on. Defaults to 127.0.0.1 when PROD=1 (only
# Caddy needs to reach it) and to every interface otherwise (LAN phone testing).
BIND_ADDR=
# Optional. IANA zone for game start and end dates. Defaults to UTC.
TIMEZONE=
TWELVEDATA_API_KEY=
# Optional. Comma-separated symbols the Twelve Data jobs are limited to. Set it
# on a dev machine so dev doesn't eat into production's 610 credits a minute.
TWELVEDATA_SYMBOLS=
MONITOR_URL=
MONITOR_API_KEY=
# Learn (Rob's videos). Each part is off until its keys are set.
# YouTube Data API v3 key; syncs the channel and spots live streams.
YOUTUBE_API_KEY=
# Optional. Handle or channel id. Defaults to @ConsortiumPW.
YOUTUBE_CHANNEL=
# Claude API key; sorts videos and questions into topics.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
CLAUDE_MODEL=
# TikTok app (developers.tiktok.com, Login Kit + Display API). Register
# BASE_URL/admin/learn/tiktok/callback as its redirect URI.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional. Replaces the general advice warning under Learn pages.
LEARN_DISCLAIMER=
