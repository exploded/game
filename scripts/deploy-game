#!/bin/bash
# /usr/local/bin/deploy-game
# Runs as root (via sudo) during GitHub Actions deployments.
#
# To update this script on the server, include scripts/deploy-game in the SCP
# bundle — it will self-update and re-exec before doing anything else.

set -e

DEPLOY_SRC="${1:-/tmp/game-deploy}"
DEPLOY_DIR=/var/www/game

# Self-update: if the bundle contains a newer version of this script, install
# it and re-exec so the rest of the deployment runs with the updated logic.
BUNDLE_SCRIPT="$DEPLOY_SRC/scripts/deploy-game"
if [ -f "$BUNDLE_SCRIPT" ] && ! diff -q /usr/local/bin/deploy-game "$BUNDLE_SCRIPT" > /dev/null 2>&1; then
    echo "[deploy] Updating deploy script from bundle..."
    install -m 755 "$BUNDLE_SCRIPT" /usr/local/bin/deploy-game
    exec /usr/local/bin/deploy-game "$@"
fi

# Read the service owner from the installed unit — no hardcoded username
SERVICE_USER=$(systemctl show game --property=User --value)
SERVICE_GROUP=$(systemctl show game --property=Group --value)

if [ -z "$SERVICE_USER" ]; then
    echo "[deploy] ERROR: Could not read User from game.service"
    exit 1
fi

echo "[deploy] Stopping service..."
systemctl stop game || true

echo "[deploy] Installing binary to $DEPLOY_DIR/game (owner: $SERVICE_USER:$SERVICE_GROUP)..."
rm -f "$DEPLOY_DIR/game"
cp "$DEPLOY_SRC/game" "$DEPLOY_DIR/game"
chmod +x "$DEPLOY_DIR/game"

# Templates, static files and the schema are embedded in the binary now. Remove
# the copies earlier deploys left, so nobody edits them expecting a change.
rm -rf "$DEPLOY_DIR/sql" "$DEPLOY_DIR/templates" "$DEPLOY_DIR/static"

chown -R "$SERVICE_USER:$SERVICE_GROUP" "$DEPLOY_DIR"

# Provisioning can't enable the unit before the binary exists, so do it here.
echo "[deploy] Enabling service on boot..."
systemctl enable game

echo "[deploy] Starting service..."
systemctl start game

echo "[deploy] Verifying service is active..."
for i in 1 2 3 4 5; do
    if systemctl is-active --quiet game; then
        break
    fi
    sleep 1
done
if ! systemctl is-active --quiet game; then
    echo "[deploy] ERROR: Service failed to start. Status:"
    systemctl status game --no-pager --lines=30
    exit 1
fi

# is-active only means the process is running. /health also proves it is
# listening and can reach the database.
PORT=$(grep -E '^PORT=' "$DEPLOY_DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]')
PORT="${PORT:-8888}"
echo "[deploy] Checking http://127.0.0.1:$PORT/health..."
for i in $(seq 1 10); do
    if curl -fsS --max-time 3 "http://127.0.0.1:$PORT/health" > /dev/null 2>&1; then
        break
    fi
    sleep 1
done
if ! curl -fsS --max-time 3 "http://127.0.0.1:$PORT/health" > /dev/null; then
    echo "[deploy] ERROR: /health did not return 200. Recent logs:"
    journalctl -u game --no-pager --lines=30
    exit 1
fi

echo "[deploy] Cleaning up..."
rm -rf "$DEPLOY_SRC"

echo "[deploy] Done — game is running."
