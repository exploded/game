#!/bin/bash
# /usr/local/bin/deploy-game
# Runs as root (via sudo) during GitHub Actions deployments.
#
# To update this script on the server, include scripts/deploy-game in the SCP
# bundle — it will self-update and re-exec before doing anything else.
#
# What a deploy does:
#   1. Stops the service and copies game.db to pre-deploy/<time>/ (the last 3
#      are kept), before the new binary can run its migrations.
#   2. Keeps the running binary as game.prev and installs the new one.
#   3. Writes the systemd drop-ins (capacity limits, UMask) and makes the
#      database files readable by the service user only.
#   4. Starts the service and checks /health. If that fails, it puts game.prev
#      back, restarts it and exits 1, so the Actions run fails.

set -eu -o pipefail

DEPLOY_SRC="${1:-/tmp/game-deploy}"
DEPLOY_DIR=/var/www/game

# Self-update: if the bundle contains a newer version of this script, install
# it and re-exec so the rest of the deployment runs with the updated logic.
BUNDLE_SCRIPT="$DEPLOY_SRC/scripts/deploy-game"
if [ -f "$BUNDLE_SCRIPT" ] && ! diff -q /usr/local/bin/deploy-game "$BUNDLE_SCRIPT" > /dev/null 2>&1; then
    echo "[deploy] Updating deploy script from bundle..."
    install -m 755 "$BUNDLE_SCRIPT" /usr/local/bin/deploy-game
    exec /usr/local/bin/deploy-game "$@"
fi

if [ ! -f "$DEPLOY_SRC/game" ]; then
    echo "[deploy] ERROR: no binary at $DEPLOY_SRC/game"
    exit 1
fi

# Read the service owner from the installed unit — no hardcoded username
SERVICE_USER=$(systemctl show game --property=User --value)
SERVICE_GROUP=$(systemctl show game --property=Group --value)

if [ -z "$SERVICE_USER" ]; then
    echo "[deploy] ERROR: Could not read User from game.service"
    exit 1
fi
SERVICE_GROUP="${SERVICE_GROUP:-$SERVICE_USER}"

PORT=$(grep -E '^PORT=' "$DEPLOY_DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d '[:space:]' || true)
PORT="${PORT:-8888}"

DB="$DEPLOY_DIR/game.db"
BACKUP_ROOT="$DEPLOY_DIR/pre-deploy"
KEEP_BACKUPS=3

# lock_down makes a file readable and writable by the service user only.
lock_down() {
    if [ -e "$1" ]; then
        chown "$SERVICE_USER:$SERVICE_GROUP" "$1"
        chmod 600 "$1"
    fi
}

# healthy waits for the service to be active and /health to return 200.
# is-active only means the process is running. /health also proves it is
# listening and can reach the database.
healthy() {
    local i
    for i in 1 2 3 4 5; do
        if systemctl is-active --quiet game; then
            break
        fi
        sleep 1
    done
    if ! systemctl is-active --quiet game; then
        echo "[deploy] Service is not active. Status:"
        systemctl status game --no-pager --lines=30 || true
        return 1
    fi
    echo "[deploy] Checking http://127.0.0.1:$PORT/health..."
    # Up to a minute: a slow migration on start shouldn't be mistaken for a
    # failure (a rollback would stop the service mid-migration).
    for i in $(seq 1 60); do
        if curl -fsS --max-time 3 "http://127.0.0.1:$PORT/health" > /dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    echo "[deploy] /health did not return 200. Recent logs:"
    journalctl -u game --no-pager --lines=30 || true
    return 1
}

# backup_db copies game.db to pre-deploy/<time>/ while the service is stopped,
# so a migration that goes wrong can be undone by hand (README.md, Backups).
# It never stops the deploy: a failure is a warning.
backup_db() {
    if [ ! -f "$DB" ]; then
        echo "[deploy] No game.db yet, so no pre-deploy backup."
        return 0
    fi

    # Room for the copy, with as much again to spare.
    local size avail
    size=$(stat -c %s "$DB")
    if [ -f "$DB-wal" ]; then
        size=$((size + $(stat -c %s "$DB-wal")))
    fi
    avail=$(df -PB1 "$DEPLOY_DIR" | awk 'NR == 2 { print $4 }')
    if [ -z "$avail" ] || [ "$avail" -lt $((size * 2)) ]; then
        echo "[deploy] WARNING: only ${avail:-?} bytes free, game.db needs $((size * 2)). Skipping the pre-deploy backup."
        return 0
    fi

    local stamp dest f ok=0
    stamp=$(date -u +%Y%m%d-%H%M%S)
    dest="$BACKUP_ROOT/$stamp"
    mkdir -p "$BACKUP_ROOT"
    chown "$SERVICE_USER:$SERVICE_GROUP" "$BACKUP_ROOT"
    chmod 700 "$BACKUP_ROOT"
    mkdir -p "$dest"
    chown "$SERVICE_USER:$SERVICE_GROUP" "$dest"
    chmod 700 "$dest"

    echo "[deploy] Backing up game.db to $dest..."
    if command -v sqlite3 > /dev/null 2>&1; then
        # sqlite3's .backup writes one self-contained file with the WAL folded
        # in. It runs as the service user, so any -wal or -shm file it makes
        # next to game.db belongs to that user, not root.
        if (cd "$DEPLOY_DIR" && runuser -u "$SERVICE_USER" -- sqlite3 -batch -init /dev/null "$DB" ".backup '$dest/game.db'"); then
            ok=1
        else
            echo "[deploy] WARNING: sqlite3 .backup failed, copying the files instead."
            rm -f "$dest/game.db"
        fi
    fi
    if [ "$ok" = 0 ]; then
        if systemctl is-active --quiet game; then
            echo "[deploy] WARNING: the service is still running, so a file copy wouldn't be consistent. Skipping the pre-deploy backup."
            rm -rf "$dest"
            return 0
        fi
        # With the service stopped, game.db with its -wal and -shm is a
        # consistent set: restore all three together.
        for f in "$DB" "$DB-wal" "$DB-shm"; do
            if [ -f "$f" ]; then
                cp -p "$f" "$dest/" || { echo "[deploy] WARNING: copying $f failed."; rm -rf "$dest"; return 0; }
            fi
        done
    fi
    for f in "$dest"/*; do
        lock_down "$f"
    done
    echo "[deploy] Backup done ($(du -sh "$dest" | cut -f1))."

    # Keep the newest $KEEP_BACKUPS. The names are UTC times, so they sort.
    local old
    while IFS= read -r old; do
        [ -n "$old" ] || continue
        echo "[deploy] Removing old backup $old"
        rm -rf "$old"
    done < <(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*' | sort | head -n -"$KEEP_BACKUPS")
}

echo "[deploy] Stopping service..."
systemctl stop game || true

backup_db

echo "[deploy] Installing binary to $DEPLOY_DIR/game (owner: $SERVICE_USER:$SERVICE_GROUP)..."
# Keep the running binary as game.prev for a rollback. The new one goes in
# under a temporary name first, so game is never a half-copied file.
install -m 755 -o "$SERVICE_USER" -g "$SERVICE_GROUP" "$DEPLOY_SRC/game" "$DEPLOY_DIR/game.new"
if [ -f "$DEPLOY_DIR/game" ]; then
    mv -f "$DEPLOY_DIR/game" "$DEPLOY_DIR/game.prev"
fi
mv -f "$DEPLOY_DIR/game.new" "$DEPLOY_DIR/game"

# Templates, static files and the schema are embedded in the binary now. Remove
# the copies earlier deploys left, so nobody edits them expecting a change.
rm -rf "$DEPLOY_DIR/sql" "$DEPLOY_DIR/templates" "$DEPLOY_DIR/static"

chown -R "$SERVICE_USER:$SERVICE_GROUP" "$DEPLOY_DIR"

# The database holds players' email addresses: only the service user may read
# it. UMask=0077 below keeps new files (the WAL, the S3 backup's snapshot)
# that way too.
for f in "$DB" "$DB-wal" "$DB-shm" "$DEPLOY_DIR/.env"; do
    lock_down "$f"
done

# Capacity limits: the game shares this box with the other apps, so it may
# not take all the memory or both CPUs. Written on every deploy, so a change
# here ships with the code. Why these values: docs/capacity.md.
echo "[deploy] Writing capacity limits and hardening..."
mkdir -p /etc/systemd/system/game.service.d
cat > /etc/systemd/system/game.service.d/limits.conf <<'LIMITS'
# Written by /usr/local/bin/deploy-game (scripts/deploy-game in the repo).
# Why these values: docs/capacity.md.
[Service]
MemoryHigh=512M
MemoryMax=768M
CPUQuota=150%
Environment=GOMEMLIMIT=400MiB
LIMITS
cat > /etc/systemd/system/game.service.d/hardening.conf <<'HARDENING'
# Written by /usr/local/bin/deploy-game (scripts/deploy-game in the repo).
# Files the app creates (game.db, its -wal and -shm, backup snapshots) are
# readable by the service user only.
[Service]
UMask=0077
HARDENING
systemctl daemon-reload

# Provisioning can't enable the unit before the binary exists, so do it here.
echo "[deploy] Enabling service on boot..."
systemctl enable game

echo "[deploy] Starting service..."
systemctl start game || true

if ! healthy; then
    echo "[deploy] ERROR: the new binary failed its health check."
    if [ -f "$DEPLOY_DIR/game.prev" ]; then
        # The database is left as the new binary left it. That's safe only
        # while migrations are additive (new tables and columns, which the old
        # binary ignores). If a migration dropped or reshaped something, restore
        # the pre-deploy backup by hand (README.md, Backups): this script never
        # restores the database itself.
        echo "[deploy] Rolling back to game.prev..."
        systemctl stop game || true
        cp -p "$DEPLOY_DIR/game.prev" "$DEPLOY_DIR/game.new"
        mv -f "$DEPLOY_DIR/game.new" "$DEPLOY_DIR/game"
        systemctl start game || true
        if healthy; then
            echo "[deploy] Rolled back: the previous binary is running."
        else
            echo "[deploy] ERROR: the previous binary is unhealthy too."
        fi
    else
        echo "[deploy] No game.prev to roll back to."
    fi
    echo "[deploy] Deploy FAILED. The bundle is left in $DEPLOY_SRC."
    exit 1
fi

echo "[deploy] Cleaning up..."
rm -rf "$DEPLOY_SRC"

echo "[deploy] Done — game is running."
